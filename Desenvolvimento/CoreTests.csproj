<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType><TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings><Nullable>disable</Nullable><EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="CoreTests.cs" />
    <Compile Include="../WorldChronicle/Code/Core/*.cs" Link="Core/%(Filename)%(Extension)" />
    <Reference Include="Newtonsoft.Json" Condition="'$(NewtonsoftPath)' != ''"><HintPath>$(NewtonsoftPath)</HintPath></Reference>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" Condition="'$(NewtonsoftPath)' == ''" />
  </ItemGroup>
</Project>
